# gmx_MMPBSA 1.7 — primary end-point estimate (GB-neck2), run once per replica and per @INTDIEL@ in {1, 2, 4}.
# Frames: production xtc holds Complex atoms every 10 ps (10,001 frames, 0-100 ns; frame 1 is t = 0). The first
# 20 ns are discarded; one frame per 0.5 ns of the last 80 ns is analysed (160 frames per replica, 480 per system).
# If PROD_NS changes the production length, set endframe = PROD_NS * 100 here and in mmpbsa_pb.in.
# Single-trajectory protocol: receptor and ligand geometries are taken from the complex frames.
# Entropy is NOT estimated (normal-mode/IE terms are too noisy at this sampling and are not needed for a
# ranking). Results are reported as a relative ranking ± SEM across the 3 replicas, never as affinities.
&general
  sys_name             = "@SYSTEM@_rep@REP@_eps@INTDIEL@",
  startframe           = 2001,
  endframe             = 10000,
  interval             = 50,
  temperature          = 310,
  PBRadii              = 4,          # mbondi3, the radius set GB-neck2 was parametrised with
  keep_files           = 0,
  verbose              = 1,
/
&gb
  igb                  = 8,          # GB-neck2 (Nguyen, Roe & Simmerling 2013)
  intdiel              = @INTDIEL@,
  extdiel              = 78.5,
  saltcon              = 0.15,       # matches the explicit 0.15 M NaCl of the simulations
  surften              = 0.0072,
  surfoff              = 0.0,
  molsurf              = 0,
/
&decomp
  idecomp              = 2,          # per-residue, 1-4 terms added to internal energies
  dec_verbose          = 0,
  print_res            = "within 6", # residues with any atom within 6 Å of the ligand
/
