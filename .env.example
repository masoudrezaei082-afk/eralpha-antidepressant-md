# Copy to .env for local tools. Never bake any of this into the image or commit it.
# Google Drive is reached through rclone (remote "gdrive", scope drive.file, your own OAuth client; see
# docs/cloud_run.md). Its credentials stay in rclone's own config; `submit.py group` copies them into the
# container group's environment as RCLONE_CONFIG_GDRIVE_* variables.
DRIVE_REMOTE=gdrive:eralpha-antidepressant-md
SALAD_API_KEY=
SALAD_ORG=
SALAD_PROJECT=
# Only while the GHCR package is private: a classic token with read:packages only
GHCR_USER=
GHCR_TOKEN=
# Used by `status` for the spend and budget lines
PRICE_PER_H=0.17
BUDGET_USD=30
